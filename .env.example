# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Site — set this to the live https origin so canonical URLs and the sitemap are correct
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics — leave blank to disable. GA4 measurement ID looks like G-XXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Microsoft Clarity project ID, from Clarity → Settings → Overview
NEXT_PUBLIC_CLARITY_PROJECT_ID=
